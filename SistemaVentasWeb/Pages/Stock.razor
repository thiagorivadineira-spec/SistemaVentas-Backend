@page "/stock"
@attribute [Authorize(Roles = "Admin,Cajero")]
@inject ApiClient Api

<PageTitle>Stock</PageTitle>

<h1 class="h3 mb-3">Stock actualizado</h1>

@if (_error != null)
{
    <div class="alert alert-danger">@_error</div>
}

<div class="row g-2 mb-3">
    <div class="col-md-6 col-lg-4">
        <input class="form-control" placeholder="Buscar producto..." value="@_busqueda" @oninput="AlBuscar" />
    </div>
    <div class="col-auto">
        <button class="btn btn-outline-secondary" @onclick="() => Cargar(_pagina)">Actualizar</button>
    </div>
</div>

@if (_cargando)
{
    <p class="text-muted">Cargando...</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-sm table-striped align-middle">
            <thead>
                <tr>
                    <th>Producto</th>
                    <th>Categoría</th>
                    <th class="text-end">Precio venta</th>
                    <th class="text-end">Stock</th>
                    <th class="text-end">Reposición</th>
                    <th class="text-end">Máximo</th>
                    <th>Estado</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in _productos)
                {
                    var estado = Estado(p);
                    <tr>
                        <td>@p.Nombre</td>
                        <td>@p.CategoriaNombre</td>
                        <td class="text-end">@Formato.Dinero(p.PrecioVenta)</td>
                        <td class="text-end fw-semibold">@p.StockActual</td>
                        <td class="text-end">@p.PuntoReposicion</td>
                        <td class="text-end">@p.StockMaximo</td>
                        <td><span class="badge @estado.clase">@estado.texto</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <p class="small text-muted">@_total producto(s) encontrados.</p>
    <Paginador Pagina="_pagina" TotalPaginas="_totalPaginas" AlCambiar="Cargar" />
}

@code {
    private readonly Debouncer _debounce = new();

    private List<Producto> _productos = new();
    private string _busqueda = string.Empty;
    private string? _error;
    private bool _cargando;
    private int _pagina = 1;
    private int _totalPaginas;
    private int _total;

    protected override async Task OnInitializedAsync()
    {
        await Cargar(1);
    }

    private async Task Cargar(int pagina)
    {
        _cargando = true;
        _error = null;

        var r = await Api.GetProductosAsync(_busqueda, pagina, 15, "nombre");
        _cargando = false;

        if (r.Ok && r.Datos != null)
        {
            _productos = r.Datos.Datos;
            _pagina = r.Datos.PaginaActual;
            _totalPaginas = r.Datos.TotalPaginas;
            _total = r.Datos.TotalRegistros;
        }
        else
        {
            _error = r.Error;
        }
    }

    private async Task AlBuscar(ChangeEventArgs e)
    {
        _busqueda = e.Value?.ToString() ?? string.Empty;
        await _debounce.EjecutarAsync(() => Cargar(1));
    }

    private static (string texto, string clase) Estado(Producto p) =>
        !p.Activo ? ("Inactivo", "bg-secondary")
        : p.StockActual <= 0 ? ("Sin stock", "bg-danger")
        : p.StockActual <= p.PuntoReposicion ? ("Reponer", "bg-warning text-dark")
        : ("OK", "bg-success");
}
