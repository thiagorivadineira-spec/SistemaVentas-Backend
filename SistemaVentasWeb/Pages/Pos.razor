@page "/pos"
@attribute [Authorize(Roles = "Admin,Cajero")]
@inject ApiClient Api

<PageTitle>Punto de venta</PageTitle>

<h1 class="h3 mb-3">Punto de venta</h1>

@if (_ok != null)
{
    <div class="alert alert-success">@_ok</div>
}
@if (_error != null)
{
    <div class="alert alert-danger">@_error</div>
}

<div class="row g-3">
    @* ---------- Catálogo ---------- *@
    <div class="col-lg-7">
        <input class="form-control mb-3" placeholder="Buscar producto por nombre o descripción..."
               value="@_busqueda" @oninput="AlBuscar" />

        @if (_cargando)
        {
            <p class="text-muted">Cargando productos...</p>
        }
        else if (_productos.Count == 0)
        {
            <p class="text-muted">No se encontraron productos.</p>
        }
        else
        {
            <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-2">
                @foreach (var p in _productos)
                {
                    var enTicket = _ticket.FirstOrDefault(l => l.Producto.Id == p.Id)?.Cantidad ?? 0;
                    var disponible = p.StockActual - enTicket;
                    var imagen = Api.UrlImagen(p.Imagenes.FirstOrDefault()?.Url);

                    <div class="col">
                        <div class="card h-100">
                            @if (imagen != null)
                            {
                                <img src="@imagen" alt="@p.Nombre" class="card-img-top" style="height:90px;object-fit:cover" />
                            }
                            <div class="card-body p-2 d-flex flex-column">
                                <div class="fw-semibold">@p.Nombre</div>
                                <div class="small text-muted">@p.CategoriaNombre</div>
                                <div class="mt-auto pt-2 d-flex justify-content-between align-items-center">
                                    <span class="fs-5">@Formato.Dinero(p.PrecioVenta)</span>
                                    <span class="badge @(disponible <= 0 ? "bg-secondary" : p.StockActual <= p.PuntoReposicion ? "bg-warning text-dark" : "bg-success")">
                                        Stock: @p.StockActual
                                    </span>
                                </div>
                                <button class="btn btn-primary btn-sm mt-2" disabled="@(disponible <= 0)" @onclick="() => Agregar(p)">
                                    @(p.StockActual <= 0 ? "Sin stock" : "Agregar")
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    @* ---------- Ticket ---------- *@
    <div class="col-lg-5">
        <div class="card shadow-sm" style="position:sticky;top:1rem">
            <div class="card-header fw-semibold">Ticket de venta</div>
            <div class="card-body">

                <div class="mb-3">
                    <label class="form-label small mb-1">Cliente</label>
                    @if (_cliente == null)
                    {
                        <div class="input-group input-group-sm">
                            <span class="input-group-text">Consumidor final</span>
                            <input class="form-control" placeholder="Buscar otro cliente..."
                                   value="@_busquedaCliente" @oninput="AlBuscarCliente" />
                        </div>
                        @if (_resultadosClientes.Count > 0)
                        {
                            <div class="list-group mt-1">
                                @foreach (var c in _resultadosClientes)
                                {
                                    <button class="list-group-item list-group-item-action py-1" @onclick="() => ElegirCliente(c)">
                                        @c.Nombre
                                        @if (!string.IsNullOrWhiteSpace(c.Documento))
                                        {
                                            <small class="text-muted"> · @c.Documento</small>
                                        }
                                    </button>
                                }
                            </div>
                        }
                    }
                    else
                    {
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="badge bg-info text-dark fs-6">@_cliente.Nombre</span>
                            <button class="btn btn-link btn-sm" @onclick="QuitarCliente">Quitar</button>
                        </div>
                    }
                </div>

                @if (_ticket.Count == 0)
                {
                    <p class="text-muted mb-0">Agregá productos desde el catálogo.</p>
                }
                else
                {
                    <table class="table table-sm align-middle">
                        <thead>
                            <tr>
                                <th>Producto</th>
                                <th style="width:90px">Cant.</th>
                                <th class="text-end">Subtotal</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var l in _ticket)
                            {
                                <tr>
                                    <td>
                                        @l.Producto.Nombre
                                        <div class="small text-muted">@Formato.Dinero(l.Producto.PrecioVenta) c/u</div>
                                    </td>
                                    <td>
                                        <input type="number" class="form-control form-control-sm" min="1" max="@l.Producto.StockActual"
                                               value="@l.Cantidad" @onchange="e => CambiarCantidad(l, e)" />
                                    </td>
                                    <td class="text-end">@Formato.Dinero(l.Subtotal)</td>
                                    <td><button class="btn btn-sm btn-outline-danger" @onclick="() => Quitar(l)">✕</button></td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    <div class="d-flex justify-content-between align-items-center fs-4 mb-3">
                        <span>Total</span>
                        <strong>@Formato.Dinero(_ticket.Sum(l => l.Subtotal))</strong>
                    </div>

                    <div class="d-grid gap-2">
                        <button class="btn btn-success btn-lg" disabled="@_procesando" @onclick="Cobrar">
                            @(_procesando ? "Registrando..." : "Cerrar venta")
                        </button>
                        <button class="btn btn-outline-secondary btn-sm" disabled="@_procesando" @onclick="VaciarTicket">Vaciar ticket</button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private readonly Debouncer _debounceProductos = new();
    private readonly Debouncer _debounceClientes = new();
    private readonly List<LineaTicket> _ticket = new();

    private List<Producto> _productos = new();
    private List<Cliente> _resultadosClientes = new();
    private Cliente? _cliente; // null = Consumidor final

    private string _busqueda = string.Empty;
    private string _busquedaCliente = string.Empty;
    private string? _ok;
    private string? _error;
    private bool _cargando;
    private bool _procesando;

    protected override async Task OnInitializedAsync()
    {
        await CargarProductos();
    }

    private async Task CargarProductos()
    {
        _cargando = true;
        var r = await Api.GetProductosAsync(_busqueda, 1, 24, "nombre");
        _cargando = false;

        if (r.Ok && r.Datos != null)
        {
            _productos = r.Datos.Datos;
        }
        else
        {
            _error = r.Error;
        }
    }

    private async Task AlBuscar(ChangeEventArgs e)
    {
        _busqueda = e.Value?.ToString() ?? string.Empty;
        await _debounceProductos.EjecutarAsync(CargarProductos);
    }

    private async Task AlBuscarCliente(ChangeEventArgs e)
    {
        _busquedaCliente = e.Value?.ToString() ?? string.Empty;

        await _debounceClientes.EjecutarAsync(async () =>
        {
            if (_busquedaCliente.Trim().Length < 2)
            {
                _resultadosClientes = new List<Cliente>();
                return;
            }

            var r = await Api.GetClientesAsync(_busquedaCliente.Trim());
            _resultadosClientes = r.Ok && r.Datos != null ? r.Datos.Datos : new List<Cliente>();
        });
    }

    private void ElegirCliente(Cliente cliente)
    {
        _cliente = cliente;
        _resultadosClientes = new List<Cliente>();
        _busquedaCliente = string.Empty;
    }

    private void QuitarCliente() => _cliente = null;

    private void Agregar(Producto producto)
    {
        _ok = null;
        _error = null;

        var linea = _ticket.FirstOrDefault(l => l.Producto.Id == producto.Id);

        if (linea == null)
        {
            if (producto.StockActual <= 0) return;
            _ticket.Add(new LineaTicket { Producto = producto, Cantidad = 1 });
        }
        else if (linea.Cantidad < producto.StockActual)
        {
            linea.Cantidad++;
        }
        else
        {
            _error = $"No hay más stock de {producto.Nombre} (disponible: {producto.StockActual}).";
        }
    }

    private void CambiarCantidad(LineaTicket linea, ChangeEventArgs e)
    {
        _error = null;

        if (!int.TryParse(e.Value?.ToString(), out var cantidad) || cantidad < 1)
        {
            cantidad = 1;
        }

        if (cantidad > linea.Producto.StockActual)
        {
            cantidad = linea.Producto.StockActual;
            _error = $"Solo hay {linea.Producto.StockActual} unidades de {linea.Producto.Nombre}.";
        }

        linea.Cantidad = cantidad;
    }

    private void Quitar(LineaTicket linea) => _ticket.Remove(linea);

    private void VaciarTicket()
    {
        _ticket.Clear();
        _cliente = null;
    }

    private async Task Cobrar()
    {
        if (_ticket.Count == 0 || _procesando) return;

        _procesando = true;
        _ok = null;
        _error = null;

        var pedido = new VentaRequest
        {
            ClienteId = _cliente?.Id,
            Detalles = _ticket.Select(l => new DetalleVentaRequest
            {
                ProductoId = l.Producto.Id,
                Cantidad = l.Cantidad
            }).ToList()
        };

        var r = await Api.CrearVentaAsync(pedido);

        if (r.Ok && r.Datos != null)
        {
            _ok = $"Venta #{r.Datos.VentaId} registrada por {Formato.Dinero(r.Datos.Total)}.";
            _ticket.Clear();
            _cliente = null;
        }
        else
        {
            _error = r.Error;
        }

        _procesando = false;

        // Se recarga el catálogo para mostrar el stock actualizado (o corregido si falló por stock)
        await CargarProductos();
    }
}
